# Copier en .env et remplir — ou exporter ces variables directement.
# Copiez ce fichier en `.env` et remplissez-le, ou exportez les variables directement.

# Clé API Mistral (obligatoire) : https://console.mistral.ai
MISTRAL_API_KEY=

# Serveur SMTP pour l'envoi des coordonnées (optionnel : sans ces valeurs,
# les e-mails sont enregistrés dans outbox/ au format .eml)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Emplacements personnalisables (optionnel)
# ROUTING_FILE=config/routing.yaml
# OUTBOX_DIR=outbox
