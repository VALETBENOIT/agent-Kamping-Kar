# Copiez ce fichier en `.env` et remplissez-le, ou exportez les variables directement.

# Clé API Mistral (obligatoire) : https://console.mistral.ai
MISTRAL_API_KEY=

# Serveur SMTP pour l'envoi des coordonnées.
# Valeurs pré-remplies pour Outlook.com / Outlook.fr (adresses @outlook.fr, @outlook.com, @hotmail.fr...) :
# utilisez le mot de passe de votre compte Outlook (ou un mot de passe d'application
# si la double authentification est activée : https://account.live.com/proofs/AppPassword).
# Sans SMTP configuré, les e-mails sont enregistrés dans outbox/ au format .eml.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=gocars-50@outlook.fr
SMTP_PASSWORD=

# Emplacements personnalisables (optionnel)
# ROUTING_FILE=config/routing.yaml
# OUTBOX_DIR=outbox
